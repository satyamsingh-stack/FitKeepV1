# Django Settings
DEBUG=False
SECRET_KEY=replace-this-with-a-long-random-secret-before-deploying
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
NGROK_DOMAIN=paragogic-grant-noninternational.ngrok-free.dev
# Add https://<your-ngrok-domain> here if your tunnel hostname changes.
CSRF_TRUSTED_ORIGINS=

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@gymplatform.local

# SMS Provider (Optional)
SMS_PROVIDER=
SMS_API_KEY=

# Rate Limiting
RATELIMIT_ENABLE=True
RATELIMIT_LOGIN_ATTEMPTS=5
RATELIMIT_LOGIN_PERIOD=300

# QR Code
QR_CODE_EXPIRY_HOURS=24

# Timezone
STREAK_TIMEZONE=UTC